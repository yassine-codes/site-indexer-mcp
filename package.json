{
  "name": "site-indexer",
  "version": "0.1.0",
  "description": "Local MCP server that takes a freshly deployed static site to verified in Google Search Console, sitemap submitted, indexing monitored.",
  "type": "module",
  "bin": {
    "site-indexer": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "google-search-console",
    "site-verification",
    "sitemap",
    "indexnow",
    "seo"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassine-codes/site-indexer-mcp.git"
  }
}
